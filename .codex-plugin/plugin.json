{
  "name": "cloudflare-tools",
  "version": "0.9.0",
  "description": "Cloudflare tools for coding agents: zones, DNS, analytics, Workers, Pages, storage and tunnels.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/cloudflare-tools#readme",
  "repository": "https://github.com/craft-agent/cloudflare-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "cloudflare-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "env_vars": [
        "CLOUDFLARE_TOOLS_TOOLSETS",
        "CLOUDFLARE_TOOLS_READ_ONLY",
        "CLOUDFLARE_TOOLS_TOOLS",
        "CLOUDFLARE_TOOLS_EXCLUDE_TOOLS",
        "CLOUDFLARE_TOOLS_CONFIRM"
      ]
    }
  }
}
